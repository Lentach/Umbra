{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "dart": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "dart",
        "mcp-server",
        "--disable",
        "pub_dev_search"
      ]
    },
    "chrome-devtools": {
      "type": "stdio",
      "enabled": false,
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "chrome-devtools-mcp@1.9.0",
        "--isolated",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    },
    "github": {
      "type": "stdio",
      "enabled": false,
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "-e",
        "GITHUB_TOOLSETS",
        "-e",
        "GITHUB_READ_ONLY",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "GITHUB_PERSONAL_ACCESS_TOKEN",
        "GITHUB_TOOLSETS": "actions,pull_requests,issues",
        "GITHUB_READ_ONLY": "true"
      }
    }
  }
}
